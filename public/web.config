<?xml version="1.0" encoding="UTF-8"?>
<!--
    Kore ERP — IIS web.config
    Required for Windows Server / IIS deployment with URL Rewrite module.
    Install URL Rewrite 2.1 from Microsoft: https://www.iis.net/downloads/microsoft/url-rewrite
-->
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <rule name="Kore ERP Laravel" stopProcessing="true">
                    <match url="^(.*)$" ignoreCase="false" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="false" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>
        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
            </files>
        </defaultDocument>
        <staticContent>
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
            <mimeMap fileExtension=".woff" mimeType="font/woff" />
        </staticContent>
    </system.webServer>
</configuration>
