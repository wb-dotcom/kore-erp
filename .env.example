APP_NAME="Kore ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/New_York

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── PostgreSQL + pgvector (via Laravel Sail) ───────────────────
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=kore_erp
DB_USERNAME=kore
DB_PASSWORD=

FORWARD_DB_PORT=5432

BROADCAST_CONNECTION=log
CACHE_STORE=redis
CACHE_PREFIX=kore_

FILESYSTEM_DISK=local

# ─── Queue (redis for Phase 3 AI embedding jobs) ────────────────
QUEUE_CONNECTION=redis

SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

FORWARD_REDIS_PORT=6379

# ─── Mail (Mailpit — local SMTP capture, UI at :8025) ───────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@kore-erp.local"
MAIL_FROM_NAME="${APP_NAME}"

FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# ─── Ollama (Phase 3 — Local LLM on Mac M4 host) ───────────────
# Ollama runs natively on macOS; the container reaches it via host gateway.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3

# ─── Inbound Email Webhook (Phase 2) ────────────────────────────
INBOUND_EMAIL_SECRET=change_me_in_production
INBOUND_EMAIL_STORAGE_DISK=local

# ─── Kore ERP Business Configuration ────────────────────────────
KORE_COMPANY_NAME="Your Company Name"
KORE_CURRENCY_SYMBOL=$
KORE_DATE_FORMAT="m/d/Y"
KORE_FISCAL_YEAR_START=01
KORE_INVOICE_PREFIX=INV-
KORE_TIMESHEET_PERIOD=weekly
