APP_NAME="Kore ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/New_York

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── PostgreSQL + pgvector (via Laravel Sail) ───────────────────
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=kore_erp
DB_USERNAME=kore
DB_PASSWORD=

FORWARD_DB_PORT=5432

BROADCAST_CONNECTION=log
CACHE_STORE=redis
CACHE_PREFIX=kore_

FILESYSTEM_DISK=local

# ─── Queue (redis for Phase 3 AI embedding jobs) ────────────────
QUEUE_CONNECTION=redis

SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

FORWARD_REDIS_PORT=6379

# ─── Mail (Mailpit — local SMTP capture, UI at :8025) ───────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@kore-erp.local"
MAIL_FROM_NAME="${APP_NAME}"

FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# ─── Ollama (Phase 3 — Local LLM on Mac M4 host) ───────────────
# Ollama runs natively on macOS; the container reaches it via host gateway.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3

# ─── Inbound Email Webhook (Phase 2) ────────────────────────────
INBOUND_EMAIL_SECRET=change_me_in_production
INBOUND_EMAIL_STORAGE_DISK=local

# ─── Kore ERP Business Configuration ────────────────────────────
KORE_COMPANY_NAME="Your Company Name"
KORE_CURRENCY_SYMBOL=$
KORE_DATE_FORMAT="m/d/Y"
KORE_FISCAL_YEAR_START=01
KORE_INVOICE_PREFIX=INV-
KORE_TIMESHEET_PERIOD=weekly

# ─── Document Storage ────────────────────────────────────────────
# 'local'  → storage/app/documents (default for development)
# 's3'     → AWS S3 private bucket (production recommended)
DOCUMENTS_DISK=local

# ─── AWS S3 (required when DOCUMENTS_DISK=s3) ───────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=

# ─── Google Workspace (Phase 1.5 — Google Docs export) ──────────
# Service account JSON key for Google Docs API access.
# Grant the service account Editor access to the target Drive folder.
GOOGLE_APPLICATION_CREDENTIALS=/var/www/html/storage/google-service-account.json
GOOGLE_DOCS_FOLDER_ID=

# ─── Google OAuth (Sign in with Google) ──────────────────────────
# Create OAuth 2.0 credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://yourdomain.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ─── Kore AI Settings ────────────────────────────────────────────
# All AI features run 100% locally via Ollama — no cloud API calls.
# Ollama must be installed and running on the host machine.
#
# Pull models: php artisan kore:ai:models pull llama3:8b
# List models: php artisan kore:ai:models list
# Check status: php artisan kore:ai:models status
AI_ENABLED=true
AI_DEFAULT_MODEL=llama3
AI_ENABLED_MODELS=llama3
AI_TEMPERATURE=0.7
AI_CONTEXT_WINDOW=4096

# ─── Queue Workers (run separately from web server) ──────────────
# Start these workers after deployment:
#   php artisan queue:work --queue=default    (email processing)
#   php artisan queue:work --queue=indexing   (RAG vector indexing)
#
# Or with Sail:
#   sail artisan queue:work --queue=default
#   sail artisan queue:work --queue=indexing
